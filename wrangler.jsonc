{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nskt2026-weekly-voice-demo",
  "main": "worker/demo.mjs",
  "compatibility_date": "2026-11-02",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash"
  }
}
