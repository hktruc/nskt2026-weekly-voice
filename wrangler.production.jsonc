{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nskt2026-weekly-voice",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-11-02",
  "assets": { "directory": "./dist", "binding": "ASSETS" },
  "durable_objects": { "bindings": [{ "name": "SNAPSHOT_STORE", "class_name": "SnapshotStore" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SnapshotStore"] }],
  "ai": { "binding": "AI" },
  "vars": {
    "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "AI_FREE_ONLY_CONFIRMED": "true",
    "AI_DAILY_CALL_CAP": "48",
    "AI_MAX_INPUT_CHARS": "30000",
    "AI_MAX_OUTPUT_TOKENS": "2500"
  }
}
